# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
TELEGRAM_BOT_TOKEN=your_bot_token_here
PORT=3000

# Configure at least one provider for Teles Agent. Never commit real keys.
OPENROUTER_API_KEYS=sk-or-v1-key_one,sk-or-v1-key_two
# Backward-compatible single-key form: OPENROUTER_API_KEY=sk-or-v1-your_key_here
NVIDIA_API_KEYS=nvapi-key_one,nvapi-key_two

# Optional — override the free AI model fallback chain (comma-separated)
# OPENROUTER_MODELS=openrouter/free
# NVIDIA_MODELS=meta/llama-3.1-8b-instruct
# AI_REQUEST_TIMEOUT_MS=15000

# Optional — Admin Telegram ID (default: 7049127887)
ADMIN_TELEGRAM_ID=7049127887

# The public URL where this app is hosted (used for webhook setup and bot buttons)
# Defaults to https://egatusad.com
APP_URL=https://egatusad.com

# Optional — set to false only when webhook registration is managed externally
AUTO_SETUP_WEBHOOK=true

# Optional - campaign milestone polling interval (minimum 60000; default 900000)
# AGENT_MONITOR_INTERVAL_MS=900000
