# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
TELEGRAM_BOT_TOKEN=your_bot_token_here
PORT=3000

# Required for Teles Agent (AI assistant) — get a FREE key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Optional — override the free AI model fallback chain (comma-separated)
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Optional — Admin Telegram ID (default: 7049127887)
ADMIN_TELEGRAM_ID=7049127887

# The public URL where this app is hosted (used for webhook setup and bot buttons)
# Defaults to https://egatusad.com
APP_URL=https://egatusad.com

# Optional — set to false only when webhook registration is managed externally
AUTO_SETUP_WEBHOOK=true
